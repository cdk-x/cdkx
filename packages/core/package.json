{
  "name": "@cdk-x/core",
  "version": "1.0.0-alpha.0",
  "stability": "experimental",
  "type": "module",
  "description": "Core constructs (App, Stack, Resource, Component) for the cdkx framework.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cdk-x/cdkx": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    ".jsii",
    "!**/*.tsbuildinfo"
  ],
  "author": {
    "name": "cdk-x",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cdk-x/cdkx.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "keywords": [
    "cdkx",
    "cdk",
    "constructs"
  ],
  "dependencies": {
    "constructs": "^10.8.0"
  },
  "peerDependencies": {
    "constructs": "^10.8.0"
  },
  "devDependencies": {
    "constructs": "10.8.0"
  },
  "jsii": {
    "outdir": "dist-jsii",
    "excludeTypescript": [
      "src/**/*.spec.ts",
      "src/**/*.test.ts"
    ],
    "targets": {
      "java": {
        "package": "com.cdkx.core",
        "maven": {
          "groupId": "com.cdk-x",
          "artifactId": "cdkx-core"
        }
      },
      "python": {
        "distName": "cdkx-core",
        "module": "cdkx.core"
      },
      "dotnet": {
        "namespace": "CdkX.Core",
        "packageId": "CdkX.Core"
      },
      "go": {
        "moduleName": "github.com/cdk-x/cdkx-core-go"
      }
    },
    "tsc": {
      "rootDir": "src",
      "outDir": "dist",
      "forceConsistentCasingInFileNames": true,
      "types": [
        "node"
      ]
    }
  }
}
