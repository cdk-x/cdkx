{
  "name": "@cdk-x/nx",
  "version": "1.0.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "description": "Nx plugin to scaffold and build jsii-enabled TypeScript libraries for the cdk-x family.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cdk-x/cdkx": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "executors.json"
  ],
  "author": {
    "name": "cdk-x",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cdk-x/cdkx.git",
    "directory": "packages/nx"
  },
  "license": "MIT",
  "keywords": [
    "cdkx",
    "cdk",
    "nx-plugin",
    "jsii"
  ],
  "generators": "./generators.json",
  "executors": "./executors.json",
  "dependencies": {
    "@cdk-x/generator-toolkit": "workspace:*",
    "@nx/devkit": "23.1.0",
    "@nx/js": "23.1.0",
    "@swc/helpers": "~0.5.18"
  }
}
